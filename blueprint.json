{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "HM Media PII Cleaner",
		"author": "Human Made",
		"description": "Activates HM Media PII Cleaner and imports sample media carrying personal metadata."
	},
	"landingPage": "/wp-admin/upload.php?mode=list",
	"login": true,
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": false,
		"intl": true
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "hm-media-pii-cleaner/hm-media-pii-cleaner.php"
		},
		{
			"step": "wp-cli",
			"command": "wp media import /wordpress/wp-content/plugins/hm-media-pii-cleaner/tests/fixtures/playground/sample-photo.jpg /wordpress/wp-content/plugins/hm-media-pii-cleaner/tests/fixtures/playground/sample-graphic.png /wordpress/wp-content/plugins/hm-media-pii-cleaner/tests/fixtures/playground/sample-document.pdf"
		}
	]
}
