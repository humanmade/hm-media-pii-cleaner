{
	"name": "humanmade/hm-media-pii-cleaner",
	"description": "Strips hidden metadata from publicly downloadable media at upload time, with verification and admin flagging for files that can't be safely sanitized.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Human Made Limited",
			"email": "hello@humanmade.com"
		}
	],
	"require": {
		"php": ">=8.3",
		"composer/installers": "^1 || ^2",
		"setasign/fpdf": "^1.9",
		"setasign/fpdi": "^2.6"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"humanmade/coding-standards": "^2.5",
		"phpunit/phpunit": "^11",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"scripts": {
		"lint": "phpcs",
		"test": "phpunit",
		"playground": [
			"Composer\\Config::disableProcessTimeout",
			"npx @wp-playground/cli@latest server --blueprint=blueprint.json --auto-mount"
		]
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
